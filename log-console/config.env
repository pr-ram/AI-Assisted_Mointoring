# Copy to config.env (same folder as receiver.py / pipeline.py), then:  chmod 600 config.env
# No quotes, no spaces around "=". NEVER commit this file or share it.

# --- shared with the VM (must match C:\SecurityTools\sender.env) ---
CONSOLE_TOKEN=

#Sensitive terms 
SENSITIVE_TERMS=

# --- When Claude runs ---
# daily = masking runs all day, Claude analyses everything collected ONCE per day (cheapest; alerts arrive daily)
# cycle = Claude runs on every new batch (near real time; uses much more of your plan)
CLAUDE_RUN_MODE=daily
# local Mac time, 24 h clock. If the Mac was off then, it runs at the first check afterwards.
DAILY_RUN_TIME=20:00
# if Claude fails (limit, network) retry on the next cycles, at most this many times a day
MAX_ATTEMPTS_PER_DAY=3

# --- Which Claude to use ---
# cli = your Claude Pro/Max plan, through the Claude Code CLI (no API key, no API credits)
# api = pay-per-use API key (separate billing at platform.claude.com)
CLAUDE_BACKEND=cli
# cli: model alias (haiku, sonnet).  api: full name, e.g. claude-haiku-5-5
CLAUDE_MODEL=haiku
# cli only, optional: long-lived token from the command  claude setup-token  (more reliable for background jobs)
CLAUDE_CODE_OAUTH_TOKEN=sk-
# api only:
# ANTHROPIC_API_KEY=sk-ant-...
MAX_EVENTS_PER_CALL=200

# --- what is worth an e-mail ---
MIN_SEVERITY=medium
MAX_ALERTS_PER_HOUR=6
# Extra words to hide everywhere before anything goes to Claude (names, school, street), comma separated
SENSITIVE_TERMS=
# 1 = the e-mail shows real names (restored locally). 0 = keeps tokens like USER_1.
ALERT_UNMASK=1

# --- e-mail (Gmail example: turn on 2-step verification, create an "App password") ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# --- what counts as worth an e-mail: low | medium | high
MIN_SEVERITY=medium

STRICT_GROUNDING=0

# Copy to config.env, then:  chmod 600 config.env   (never commit it, never paste it in chat)

# --- Claude through your Claude plan (no API credits). Sign in once by running:  claude
CLAUDE_BACKEND=cli
CLAUDE_MODEL=haiku
MAX_EVENTS_PER_CALL=200

# --- what counts as worth an e-mail: low | medium | high
MIN_SEVERITY=medium

# --- words to hide everywhere, comma separated (family names, school, street ...)
SENSITIVE_TERMS=

# --- 1 = the e-mail shows real names (restored on this Mac), 0 = keep the USER_1 / DOMAIN_2 tokens
ALERT_UNMASK=1

# --- Gmail. SMTP_PASSWORD is a Google *App password* (16 letters), not your Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
MAIL_FROM=you@gmail.com
MAIL_TO=you@gmail.com
